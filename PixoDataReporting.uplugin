{
	"FileVersion": 3,
	"FriendlyName": "PixoVR Data Reporting",
	"Version": 1,
	"VersionName": "2.0.0",
	"CreatedBy": "PixoVR",
	"CreatedByURL": "https://www.pixovr.com",
	"Description": "Allows communication with the PixoVR Platform API for Authorization and Sessions.",
	"Category": "PixoVR",
	"DocsURL": "https://docs.pixovr.com",
	"CanContainContent": false,
	"Modules": [
		{
			"Name": "PixoDataReporting",
			"Type": "Runtime",
			"LoadingPhase": "PreDefault"
		}
	],
	"Plugins": [
		{
			"Name": "PixoPlatformCore",
			"Enabled": true
		},
		{
			"Name": "PixoAuth",
			"Enabled": true
		}
	]
}
